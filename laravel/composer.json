{
    "name": "solosmartdigital/solosmartpay",
    "description": "Official Laravel package for Solosmartpay: QRIS, Virtual Account and e-wallet payments, webhook handling and an embeddable checkout, with no manual API code.",
    "keywords": ["laravel", "solosmartpay", "payment", "qris", "virtual-account", "payment-gateway", "indonesia", "webhook"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/solosmartdigital/solosmartpay-sdk/tree/main/laravel",
    "support": {
        "issues": "https://github.com/solosmartdigital/solosmartpay-sdk/issues",
        "source": "https://github.com/solosmartdigital/solosmartpay-sdk/tree/main/laravel"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": { "SolosmartDigital\\Solosmartpay\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "SolosmartDigital\\Solosmartpay\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["SolosmartDigital\\Solosmartpay\\SolosmartpayServiceProvider"],
            "aliases": { "Solosmartpay": "SolosmartDigital\\Solosmartpay\\Facades\\Solosmartpay" }
        }
    },
    "scripts": { "test": "vendor/bin/phpunit" },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
